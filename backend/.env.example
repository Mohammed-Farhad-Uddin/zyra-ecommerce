# Free MongoDB (Atlas) connection string. Include the database name in the path.
DB_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/aurelia?retryWrites=true&w=majority"

# Cloudinary → Dashboard. Never commit the real secret. Also set these on Vercel.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
